# Bot WhatsApp KasirWarung AI — salin file ini menjadi ".env" lalu isi.
# Dua baris pertama didapat dari aplikasi: Pengaturan → Bot WhatsApp → "Buat kode rahasia bot".

# Alamat web app (berakhiran /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Kode rahasia bot (64 huruf/angka)
BOT_SECRET=

# Nomor WhatsApp yang dipakai bot, format 62… (untuk login dengan kode pairing, cocok untuk HP yang sama).
# Kosongkan bila ingin login dengan scan QR di layar.
PAIRING_NUMBER=62xxxxxxxxxx

# Opsional
# AUTH_DIR=auth          # folder sesi login WhatsApp (jangan dibagikan!)
# POLL_SECONDS=30        # cek notifikasi pesanan tiap N detik
# REPLY_DELAY_MS=1200    # jeda "mengetik…" sebelum membalas
# LOG_LEVEL=silent       # debug untuk melihat log Baileys
