| !r.ok) {\n          const err = new Error((r && r.error) || 'Permintaan gagal.');\n          err.code = r && r.code;\n          if (err.code === 'AUTH' && fn !== 'apiMe') App.sessionExpired(err.message);\n          reject(err);\n          return;\n        }\n        resolve(r.data);\n      })\n      .withFailureHandler((err) => {\n        const msg = err && err.message ? err.message : String(err || '');\n        reject(new Error(/network|NetworkError|failed to fetch|timeout/i.test(msg)\n          ? 'Koneksi internet terputus. Periksa sinyal lalu coba lagi.'\n          : 'Server bermasalah: ' + msg));\n      })[fn].apply(null, argv);\n  });\n}\n\n/** Wraps an async action with the busy overlay and error toast. */\nasync function withBusy(text, fn) {\n  busy(true, text);\n  try { return await fn(); }\n  catch (e) { toast(e.message, 'err'); throw e; }\n  finally { busy(false); }\n}\n\n/* ---------------- Files: CSV / PDF / Drive ---------------- */\nfunction csvEscape(v) {\n  let s = v === null || v === undefined ? '' : String(v);\n  if (/^[=+\\-@]/.test(s)) s = \"'\" + s;\n  return /[\",;\\n]/.test(s) ? '\"' + s.replace(/\"/g, '\"\"') + '\"' : s;\n}\nfunction toCsv(rows, cols) {\n  const lines = [cols.map((c) => csvEscape(c.t)).join(',')];\n  rows.forEach((r) => lines.push(cols.map((c) => csvEscape(c.f ? c.f(r[c.k], r) : r[c.k])).join(',')));\n  return lines.join('\\n');\n}\n\nfunction parseCsv(text) {\n  text = String(text || '').replace(/^﻿/, '');\n  const firstLine = text.split(/\\r?\\n/)[0] || '';\n  const delim = (firstLine.split(';').length > firstLine.split(',').length) ? ';' : ',';\n  const rows = [];\n  let row = [], cur = '', q = false;\n  for (let i = 0; i < text.length; i++) {\n    const ch = text[i];\n    if (q) {\n      if (ch === '\"' && text[i + 1] === '\"') { cur += '\"'; i++; }\n      else if (ch === '\"') q = false;\n      else cur += ch;\n    } else if (ch === '\"') q = true;\n    else if (ch === delim) { row.push(cur); cur = ''; }\n    else if (ch === '\\n' || ch === '\\r') {\n      if (ch === '\\r' && text[i + 1] === '\\n') i++;\n      row.push(cur); rows.push(row); row = []; cur = '';\n    } else cur += ch;\n  }\n  if (cur !== '' || row.length) { row.push(cur); rows.push(row); }\n  const clean = rows.filter((r) => r.some((c) => String(c).trim() !== ''));\n  if (!clean.length) return [];\n  const head = clean.shift().map((h) => String(h).trim().toLowerCase());\n  return clean.map((r) => { const o = {}; head.forEach((h, i) => { o[h] = r[i] === undefined ? '' : String(r[i]).trim(); }); return o; });\n}\n\nfunction triggerDownload(blob, filename) {\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement('a');\n  a.href = url; a.download = filename; a.rel = 'noopener';\n  document.body.appendChild(a); a.click();\n  setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 1500);\n}\n\n/** Downloads in the browser and offers \"Simpan ke Drive\" as a fallback. */\nfunction offerFile(filename, content, mime, isBase64) {\n  let blob;\n  if (isBase64) {\n    const bin = atob(content);\n    const bytes = new Uint8Array(bin.length);\n    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n    blob = new Blob([bytes], { type: mime });\n  } else {\n    blob = new Blob(['﻿' + content], { type: mime + ';charset=utf-8' });\n  }\n  try { triggerDownload(blob, filename); } catch (e) { /* sandbox may block */ }\n  const m = openModal({\n    title: 'File siap',\n    body: '<p><b>' + esc(filename) + '</b> sedang diunduh.</p><p class=\"muted small\">Kalau unduhan tidak muncul di HP, simpan ke Google Drive lalu buka dari sana.</p>',\n    foot: '<button class=\"btn\" data-close>Tutup</button>' + (App.can('report') ? '<button class=\"btn btn-green\" id=\"toDrive\">' + icon('cloud') + 'Simpan ke Drive</button>' : ''),\n    noFocus: true\n  });\n  const btn = $('#toDrive', m.el);\n  if (btn) btn.addEventListener('click', async () => {\n    try {\n      const r = await withBusy('Menyimpan ke Drive…', () => api('apiSaveToDrive', filename, isBase64 ? content : '﻿' + content, mime, !!isBase64));\n      m.close();\n      openModal({ title: 'Tersimpan di Drive', body: '<p>File tersimpan di folder <b>KasirWarung AI - Ekspor</b>.</p><a class=\"btn btn-primary btn-block\" target=\"_blank\" rel=\"noopener\" href=\"' + esc(r.url) + '\">Buka file</a>', noFocus: true });\n    } catch (e) { /* toast shown */ }\n  });\n}\n\n/* ---------------- WhatsApp ---------------- */\n/** 6281234567890 → 081234567890 for display. */\nfunction phoneLocal(phone) {\n  const s = String(phone || '').replace(/[^\\d]/g, '');\n  return s.indexOf('62') === 0 ? '0' + s.slice(2) : s;\n}\nfunction waNumber(phone) {\n  let s = String(phone || '').replace(/[^\\d]/g, '');\n  if (s.indexOf('0') === 0) s = '62' + s.slice(1);\n  return s;\n}\nfunction waLink(phone, text) {\n  const n = waNumber(phone);\n  return 'https://wa.me/' + n + '?text=' + encodeURIComponent(text || '');\n}\nfunction openWa(phone, text) {\n  window.open(waLink(phone, text), '_blank', 'noopener');\n}\n\n/* ---------------- Pricing (mirror of server unitPrice_) ---------------- */\nfunction unitPrice(p, qty) {\n  let price = +p.price_retail || 0, tier = 'Eceran';\n  if (p.bundle_qty > 0 && p.price_bundle > 0 && qty >= p.bundle_qty && p.price_bundle < price) { price = p.price_bundle; tier = 'Paket'; }\n  if (p.wholesale_qty > 0 && p.price_wholesale > 0 && qty >= p.wholesale_qty && p.price_wholesale < price) { price = p.price_wholesale; tier = 'Grosir'; }\n  return { price: price, tier: tier };\n}\nfunction isWholeUnit(unit) { return unit === 'pcs' || unit === 'renteng' || unit === 'dus'; }\n\n/* ---------------- 58mm receipts ---------------- */\nfunction receiptHtml(s) {\n  const b = s.business || {};\n  const items = (s.items || []).map((i) =>\n    '<div class=\"r-item\"><div>' + esc(i.name) + '</div><div class=\"r-row\"><span>' + esc(fmtNum(i.qty)) + ' ' + esc(i.unit) + ' x ' + esc(fmtNum(i.price)) +\n    (i.tier && i.tier !== 'Eceran' ? ' (' + esc(i.tier) + ')' : '') + '</span><span>' + esc(fmtNum(i.total)) + '</span></div></div>').join('');\n  const row = (l, v, cls) => '<div class=\"r-row ' + (cls || '') + '\"><span>' + esc(l) + '</span><span>' + esc(v) + '</span></div>';\n  let h = '<div class=\"receipt\">' +\n    '<div class=\"r-c r-big\">' + esc(b.name || 'Warung') + '</div>' +\n    (b.address ? '<div class=\"r-c r-muted\">' + esc(b.address) + '</div>' : '') +\n    (b.whatsapp ? '<div class=\"r-c r-muted\">WA ' + esc(phoneLocal(b.whatsapp)) + '</div>' : '') +\n    '<div class=\"r-line\"></div>' +\n    '<div>No: ' + esc(s.trx_id) + '</div><div>' + esc(fmtDateTime(s.datetime)) + '</div>' +\n    '<div>Kasir: ' + esc(s.cashier || '') + '</div>' +\n    (s.customer ? '<div>Pelanggan: ' + esc(s.customer.name) + '</div>' : (s.customer_name ? '<div>Pelanggan: ' + esc(s.customer_name) + '</div>' : '')) +\n    '<div class=\"r-line\"></div>' + items + '<div class=\"r-line\"></div>' +\n    row('Subtotal', fmtNum(s.subtotal)) +\n    (s.discount ? row('Diskon', '-' + fmtNum(s.discount)) : '') +\n    (s.tax ? row('Pajak' + (s.tax_percent ? ' ' + s.tax_percent + '%' : ''), fmtNum(s.tax)) : '') +\n    row('TOTAL', rp(s.total), 'r-b r-big') +\n    row('Bayar (' + s.method + ')', fmtNum(s.paid));\n  if (s.method === 'Tunai') h += row('Kembali', fmtNum(s.change), 'r-b');\n  if (s.credit) {\n    h += '<div class=\"r-line\"></div>' + row('Kasbon', rp(s.credit.amount), 'r-b') + row('Jatuh tempo', fmtDate(s.credit.due_date)) + row('Total kasbon', rp(s.credit.balance));\n  }\n  if (s.status === 'Batal') h += '<div class=\"r-c r-big\">*** DIBATALKAN ***</div>';\n  h += '<div class=\"r-line\"></div><div class=\"r-c\">' + esc(b.footer || 'Terima kasih') + '</div>' +\n    '<div class=\"r-c r-muted\">KasirWarung AI · Made by Piyu</div></div>';\n  return h;\n}\n\nfunction receiptText(s) {\n  const b = s.business || {};\n  const lines = ['*' + (b.name || 'Warung') + '*', s.trx_id + ' · ' + fmtDateTime(s.datetime), '--------------------'];\n  (s.items || []).forEach((i) => {\n    lines.push(i.name);\n    lines.push('  ' + fmtNum(i.qty) + ' ' + i.unit + ' x ' + fmtNum(i.price) + ' = ' + fmtNum(i.total));\n  });\n  lines.push('--------------------');\n  if (s.discount) lines.push('Diskon: -' + rp(s.discount));\n  if (s.tax) lines.push('Pajak: ' + rp(s.tax));\n  lines.push('*TOTAL: ' + rp(s.total) + '*');\n  lines.push('Bayar (' + s.method + '): ' + rp(s.paid));\n  if (s.method === 'Tunai') lines.push('Kembali: ' + rp(s.change));\n  if (s.credit) lines.push('Kasbon: ' + rp(s.credit.amount) + ' · jatuh tempo ' + fmtDate(s.credit.due_date));\n  lines.push('', b.footer || 'Terima kasih 🙏');\n  return lines.join('\\n');\n}\n\nfunction paymentReceiptHtml(p) {\n  const b = p.business || {};\n  const row = (l, v, cls) => '<div class=\"r-row ' + (cls || '') + '\"><span>' + esc(l) + '</span><span>' + esc(v) + '</span></div>';\n  return '<div class=\"receipt\"><div class=\"r-c r-big\">' + esc(b.name || 'Warung') + '</div>' +\n    (b.address ? '<div class=\"r-c r-muted\">' + esc(b.address) + '</div>' : '') +\n    '<div class=\"r-line\"></div><div class=\"r-c r-b\">BUKTI BAYAR KASBON</div>' +\n    row('Tanggal', fmtDateTime(p.at)) + '<div>Pelanggan: ' + esc(p.name) + '</div><div>Kasir: ' + esc(p.cashier || '') + '</div>' +\n    '<div class=\"r-line\"></div>' + row('Dibayar (' + p.method + ')', rp(p.paid), 'r-b') + row('Sisa kasbon', rp(p.remaining), 'r-b') +\n    '<div class=\"r-line\"></div><div class=\"r-c\">Terima kasih 🙏</div><div class=\"r-c r-muted\">KasirWarung AI · Made by Piyu</div></div>';\n}\n\nfunction printHtml(html) {\n  $('#printArea').innerHTML = html;\n  setTimeout(() => window.print(), 50);\n}\n\n/* ---------------- Charts ---------------- */\nconst charts = {};\nfunction whenChartReady(cb, tries) {\n  if (window.Chart) { cb(); return; }\n  if ((tries || 0) > 60) return;\n  setTimeout(() => whenChartReady(cb, (tries || 0) + 1), 100);\n}\nfunction drawChart(id, config) {\n  whenChartReady(() => {\n    const cv = document.getElementById(id);\n    if (!cv) return;\n    if (charts[id]) charts[id].destroy();\n    Chart.defaults.font.family = 'Nunito, system-ui, sans-serif';\n    Chart.defaults.font.size = 13;\n    Chart.defaults.color = '#4B5563';\n    charts[id] = new Chart(cv.getContext('2d'), config);\n  });\n}\n\n/* ==========================================================================\n   App shell: session, router, header, nav, footer\n   ========================================================================== */\nconst PAGE_META = {\n  login: { title: 'Masuk', public: true },\n  setup: { title: 'Setup Wizard', perm: 'settings' },\n  dashboard: { title: 'Beranda', perm: 'dashboard', icon: 'home', nav: 1 },\n  kasir: { title: 'Kasir', perm: 'pos.sell', icon: 'cart', nav: 1 },\n  pesanan: { title: 'Pesanan WA', short: 'Pesanan', perm: 'wa.order', icon: 'wa', nav: 1 },\n  pelanggan: { title: 'Pelanggan & Kasbon', short: 'Kasbon', perm: 'customer.view', icon: 'book', nav: 1 },\n  produk: { title: 'Produk', perm: 'product.view', icon: 'box', nav: 1 },\n  stok: { title: 'Stok Masuk', perm: 'stock.in', icon: 'truck', nav: 1 },\n  laporan: { title: 'Laporan', perm: 'report', icon: 'chart', nav: 1 },\n  pengaturan: { title: 'Pengaturan', perm: 'settings', icon: 'sliders', nav: 1 },\n  panduan: { title: 'Panduan & FAQ', short: 'Panduan', public: true, icon: 'help', nav: 2 },\n  lisensi: { title: 'Lisensi', public: true, icon: 'key', nav: 2 },\n  tentang: { title: 'Tentang Aplikasi', short: 'Tentang', public: true, icon: 'star', nav: 2 },\n  syarat: { title: 'Syarat Lisensi', public: true },\n  privasi: { title: 'Kebijakan Privasi', public: true },\n  toko: { title: 'Toko Online', public: true }\n};\n\nconst App = {\n  boot: window.BOOT || {},\n  token: null, user: null, perms: {}, settings: {}, license: null, ai: {}, setupDone: false,\n  page: null, inited: {}, products: null, customers: null, expiryTimer: null,\n\n  can(perm) { return !perm || !!this.perms[perm]; },\n  canPage(page) {\n    const m = PAGE_META[page];\n    if (!m) return false;\n    if (m.public) return true;\n    return !!this.token && this.can(m.perm);\n  },\n  get openMode() { return !!this.boot.openMode; },\n  defaultPage() {\n    if (!this.token) return 'login';\n    if (this.openMode) return 'kasir';\n    if (this.can('settings') && !this.setupDone) return 'setup';\n    return this.can('dashboard') ? 'dashboard' : 'kasir';\n  },\n\n  async start() {\n    hydrateIcons(document);\n    this.renderHeader();\n    this.renderFooter();\n    this.renderLicenseBanner();\n    if (typeof google !== 'undefined' && google.script && google.script.history) {\n      google.script.history.setChangeHandler((e) => {\n        const p = e && e.location && e.location.parameter && e.location.parameter.page;\n        this.go(p || this.defaultPage(), { push: false });\n      });\n    }\n    const wanted = this.boot.page || '';\n    const saved = Store.get('token', null);\n    if (this.boot.dbReady && saved) {\n      this.token = saved;\n      try {\n        const me = await api('apiMe');\n        this.applySession(me);\n      } catch (e) {\n        this.token = null;\n        Store.del('token');\n      }\n    }\n    if (this.boot.dbReady && this.openMode && !this.token) await this.autoLogin();\n    $('#bootSplash').remove();\n    this.go(wanted && this.canPage(wanted) ? wanted : this.defaultPage(), { push: false, replace: true });\n  },\n\n  applySession(d) {\n    if (d.openMode !== undefined) this.boot.openMode = !!d.openMode;\n    this.token = d.token;\n    Store.set('token', d.token);\n    this.user = d.user;\n    this.perms = d.perms || {};\n    this.settings = d.settings || {};\n    this.license = d.license || this.license;\n    this.ai = d.ai || {};\n    this.setupDone = !!d.setupDone;\n    this.boot.business = { name: this.settings.BUSINESS_NAME, logo: this.settings.LOGO_URL, address: this.settings.BUSINESS_ADDRESS, whatsapp: this.settings.WHATSAPP };\n    this.boot.license = this.license;\n    this.products = null;\n    this.customers = null;\n    clearTimeout(this.expiryTimer);\n    const ms = (d.expiresAt || 0) - Date.now();\n    if (ms > 0 && ms < 2147483647) this.expiryTimer = setTimeout(() => this.sessionExpired('Sesi 8 jam sudah habis. Silakan login lagi.'), ms);\n    this.renderHeader();\n    this.renderNav();\n    this.renderFooter();\n    this.renderLicenseBanner();\n  },\n\n  /** Open mode (no login): get a full-access session silently. */\n  async autoLogin() {\n    try {\n      this.applySession(await api('apiAutoLogin'));\n      return true;\n    } catch (e) {\n      if (e.code === 'FORBIDDEN') this.boot.openMode = false; // owner switched login back on\n      return false;\n    }\n  },\n\n  async sessionExpired(msg) {\n    if (!this.token) return;\n    this.clearSession();\n    if (this.openMode && await this.autoLogin()) { this.go(this.page && this.page !== 'login' ? this.page : 'kasir', { push: false }); return; }\n    toast(msg || 'Sesi berakhir. Silakan login lagi.', 'err');\n    this.go('login');\n  },\n\n  clearSession() {\n    this.token = null; this.user = null; this.perms = {};\n    this.products = null; this.customers = null;\n    Store.del('token');\n    this.renderHeader();\n    this.renderNav();\n  },\n\n  async logout() {\n    try { await api('apiLogout'); } catch (e) { /* ignore */ }\n    this.clearSession();\n    toast('Sampai jumpa lagi! 👋', 'ok');\n    this.go('login');\n  },\n\n  go(page, opts) {\n    opts = opts || {};\n    if (!PAGE_META[page]) page = this.defaultPage();\n    if (!this.canPage(page)) {\n      if (this.token) toast('Menu \"' + PAGE_META[page].title + '\" hanya untuk Owner.', 'err');\n      page = this.defaultPage();\n    }\n    if (page === 'login' && this.token) page = this.defaultPage();\n    if (this.token && !this.openMode && this.can('settings') && !this.setupDone && !PAGE_META[page].public && page !== 'setup') page = 'setup';\n\n    $$('#main > .page').forEach((s) => { s.hidden = true; });\n    const sec = document.getElementById('page-' + page);\n    if (sec) sec.hidden = false;\n    this.page = page;\n    document.body.classList.toggle('auth', !this.token || page === 'setup');\n    document.title = PAGE_META[page].title + ' · ' + (this.boot.business && this.boot.business.name || 'KasirWarung AI');\n    this.highlightNav();\n    $('#userMenu').hidden = true;\n    window.scrollTo(0, 0);\n\n    const P = window.Pages[page];\n    if (P) {\n      try {\n        if (!this.inited[page] && P.init) { P.init(); this.inited[page] = true; }\n        if (P.enter) P.enter(opts.params || {});\n      } catch (e) { console.error(e); toast('Gagal membuka halaman: ' + e.message, 'err'); }\n    }\n    if (opts.push !== false && typeof google !== 'undefined' && google.script && google.script.history) {\n      google.script.history.push(null, { page: page });\n    } else if (opts.replace && typeof google !== 'undefined' && google.script && google.script.history) {\n      google.script.history.replace(null, { page: page });\n    }\n  },\n\n  /* ---------- Header ---------- */\n  renderHeader() {\n    const b = this.boot.business || {};\n    $('#brandName').textContent = b.name || 'KasirWarung AI';\n    const logo = $('#brandLogo');\n    logo.innerHTML = '';\n    if (b.logo && /^https:\\/\\//i.test(b.logo)) {\n      const img = document.createElement('img');\n      img.alt = 'Logo';\n      img.referrerPolicy = 'no-referrer';\n      img.src = b.logo;\n      img.onerror = () => { logo.innerHTML = defaultLogoSvg(); };\n      logo.appendChild(img);\n    } else logo.innerHTML = defaultLogoSvg();\n\n    const btn = $('#userBtn');\n    if (this.user) {\n      btn.hidden = false;\n      $('#userAvatar').textContent = initials(this.user.full_name);\n      $('#userName').textContent = this.user.full_name.split(' ')[0] + ' · ' + this.user.role;\n    } else {\n      btn.hidden = false;\n      $('#userAvatar').innerHTML = icon('user');\n      $('#userName').textContent = 'Masuk';\n    }\n  },\n\n  toggleUserMenu() {\n    const menu = $('#userMenu');\n    if (!this.user) { this.go('login'); return; }\n    if (!menu.hidden) { menu.hidden = true; return; }\n    menu.innerHTML = '<div class=\"um-head\"><b>' + esc(this.user.full_name) + '</b><div class=\"muted small\">@' + esc(this.user.username) + ' · ' + esc(this.user.role) + '</div></div>' +\n      (this.openMode ? '' : '<button data-act=\"password\">' + icon('lock') + 'Ganti password</button>') +\n      '<button data-act=\"panduan\">' + icon('help') + 'Panduan</button>' +\n      (this.can('settings') ? '<button data-act=\"pengaturan\">' + icon('sliders') + 'Pengaturan</button>' : '') +\n      (this.openMode ? '' : '<button data-act=\"logout\">' + icon('logout') + 'Keluar</button>');\n    menu.hidden = false;\n    $('#userBtn').setAttribute('aria-expanded', 'true');\n  },\n\n  changePassword() {\n    const m = openModal({\n      title: 'Ganti password',\n      body: '<label class=\"field\"><span>Password lama</span><input type=\"password\" id=\"cpOld\" autocomplete=\"current-password\"></label>' +\n        '<label class=\"field\"><span>Password baru</span><input type=\"password\" id=\"cpNew\" autocomplete=\"new-password\" minlength=\"6\"><span class=\"hint\">Minimal 6 karakter. Jangan gunakan tanggal lahir.</span></label>' +\n        '<label class=\"field\"><span>Ulangi password baru</span><input type=\"password\" id=\"cpNew2\" autocomplete=\"new-password\"></label>',\n      foot: '<button class=\"btn\" data-close>Batal</button><button class=\"btn btn-primary\" id=\"cpSave\">Simpan</button>'\n    });\n    $('#cpSave', m.el).addEventListener('click', async () => {\n      const o = $('#cpOld', m.el).value, n = $('#cpNew', m.el).value, n2 = $('#cpNew2', m.el).value;\n      if (n.length < 6) { toast('Password baru minimal 6 karakter', 'err'); return; }\n      if (n !== n2) { toast('Ulangi password baru belum sama', 'err'); return; }\n      try {\n        await withBusy('Menyimpan…', () => api('apiChangePassword', o, n));\n        m.close();\n        toast('Password berhasil diganti', 'ok');\n      } catch (e) { /* toast shown */ }\n    });\n  },\n\n  /* ---------- Navigation ---------- */\n  navPages() {\n    return Object.keys(PAGE_META).filter((p) => PAGE_META[p].nav && this.canPage(p));\n  },\n\n  renderNav() {\n    const side = $('#sidebar'), bottom = $('#bottomnav');\n    if (!this.token) { side.innerHTML = ''; bottom.innerHTML = ''; bottom.hidden = true; return; }\n    const pages = this.navPages();\n    const item = (p) => '<button class=\"nav-item\" data-go=\"' + p + '\">' + icon(PAGE_META[p].icon) + '<span>' + esc(PAGE_META[p].title) + '</span></button>';\n    side.innerHTML = pages.filter((p) => PAGE_META[p].nav === 1).map(item).join('') + '<div class=\"nav-sep\"></div>' +\n      pages.filter((p) => PAGE_META[p].nav === 2).map(item).join('') +\n      '<div class=\"nav-cta\"><b>Tips:</b> scan barcode langsung di kolom cari Kasir, lalu tekan Enter.</div>';\n\n    const main = (this.can('dashboard') ? ['dashboard', 'kasir', 'pelanggan', 'produk'] : ['kasir', 'pesanan', 'pelanggan', 'produk']).filter((p) => this.canPage(p));\n    bottom.innerHTML = main.map((p) => '<button data-go=\"' + p + '\">' + icon(PAGE_META[p].icon) + '<span>' + esc(PAGE_META[p].short || PAGE_META[p].title) + '</span></button>').join('') +\n      '<button data-act=\"more\">' + icon('menu') + '<span>Menu</span></button>';\n    bottom.hidden = false;\n    this.highlightNav();\n  },\n\n  highlightNav() {\n    $$('[data-go]', $('#sidebar')).concat($$('[data-go]', $('#bottomnav'))).forEach((b) => {\n      b.classList.toggle('active', b.getAttribute('data-go') === this.page);\n    });\n  },\n\n  moreMenu() {\n    const pages = this.navPages();\n    const m = openModal({\n      title: 'Menu',\n      body: '<div class=\"grid\">' + pages.map((p) => '<button class=\"nav-item\" data-go=\"' + p + '\">' + icon(PAGE_META[p].icon) + '<span>' + esc(PAGE_META[p].title) + '</span></button>').join('') +\n        (this.openMode ? '</div>' : '<div class=\"nav-sep\"></div><button class=\"nav-item\" data-act=\"password\">' + icon('lock') + '<span>Ganti password</span></button>' +\n        '<button class=\"nav-item\" data-act=\"logout\">' + icon('logout') + '<span>Keluar</span></button></div>'),\n      noFocus: true\n    });\n    m.el.addEventListener('click', (e) => { if (e.target.closest('[data-go],[data-act]')) m.close(); });\n  },\n\n  /* ---------- Footer & licence ---------- */\n  renderFooter() {\n    const a = this.boot.app || { name: 'KasirWarung AI', version: '1.0.0', maker: 'Piyu', year: 2026 };\n    const lic = this.license || this.boot.license || {};\n    const wa = a.supportWa ? '<a target=\"_blank\" rel=\"noopener\" href=\"' + esc(waLink(a.supportWa, 'Halo Piyu, saya butuh bantuan KasirWarung AI (v' + a.version + ').')) + '\">' + 'Dukungan WhatsApp</a>' : '<span>Dukungan: hubungi penjual aplikasi</span>';\n    const licCls = lic.valid ? 'b-green' : 'b-red';\n    $('#footer').innerHTML =\n      '<div class=\"f-row\"><b>© ' + esc(a.year) + ' ' + esc(a.name) + ' · Made by ' + esc(a.maker) + '</b><span class=\"dot\">•</span><span>Versi ' + esc(a.version) + '</span></div>' +\n      '<div class=\"f-row\">' + wa + '<span class=\"dot\">•</span><span>Lisensi: <a href=\"#\" data-go=\"lisensi\"><span class=\"badge ' + licCls + '\">' + esc(lic.label || '-') + '</span></a></span></div>' +\n      '<div class=\"f-row\"><a href=\"#\" data-go=\"panduan\">Panduan</a><span class=\"dot\">•</span><a href=\"#\" data-go=\"syarat\">Syarat Lisensi</a><span class=\"dot\">•</span><a href=\"#\" data-go=\"privasi\">Kebijakan Privasi</a><span class=\"dot\">•</span><a href=\"#\" data-go=\"tentang\">Tentang Aplikasi</a></div>';\n  },\n\n  renderLicenseBanner() {\n    const lic = this.license || this.boot.license || {};\n    const el = $('#licenseBanner');\n    let msg = '';\n    if (lic.status === 'TRIAL_END') msg = 'Masa trial 30 hari sudah berakhir.';\n    else if (lic.status === 'EXPIRED') msg = 'Lisensi sudah kedaluwarsa.';\n    else if (lic.status === 'INVALID') msg = 'Kunci lisensi tidak valid.';\n    else if (lic.status === 'TRIAL' && lic.daysLeft <= 7) msg = 'Trial tinggal ' + lic.daysLeft + ' hari.';\n    if (!msg) { el.hidden = true; return; }\n    el.innerHTML = esc(msg) + ' Data & penjualan tetap aman. <a href=\"#\" data-go=\"lisensi\">Aktifkan lisensi →</a>';\n    el.hidden = false;\n  },\n\n  /* ---------- Shared data caches ---------- */\n  async loadProducts(force) {\n    if (this.products && !force) return this.products;\n    this.products = await api('apiProducts', !!force);\n    return this.products;\n  },\n  async loadCustomers(force) {\n    if (this.customers && !force) return this.customers;\n    this.customers = await api('apiCustomers');\n    return this.customers;\n  }\n};\n\nfunction defaultLogoSvg() {\n  return '<svg viewBox=\"0 0 40 40\" width=\"34\" height=\"34\" aria-hidden=\"true\"><path d=\"M4 16h32l-4-9H8z\" fill=\"#F97316\"/><path d=\"M11 7l-2 9M17 7l-1 9M23 7l1 9M29 7l2 9\" stroke=\"#FFEDD5\" stroke-width=\"2.2\"/><rect x=\"7\" y=\"16\" width=\"26\" height=\"17\" rx=\"3\" fill=\"#FFF7ED\" stroke=\"#EA580C\" stroke-width=\"2\"/><rect x=\"16\" y=\"22\" width=\"8\" height=\"11\" rx=\"1.5\" fill=\"#FACC15\"/></svg>';\n}\n\n/* ---------- Global click delegation ---------- */\ndocument.addEventListener('click', (e) => {\n  const go = e.target.closest('[data-go]');\n  if (go) { e.preventDefault(); App.go(go.getAttribute('data-go')); return; }\n  const act = e.target.closest('[data-act]');\n  if (act) {\n    const a = act.getAttribute('data-act');\n    if (a === 'logout') { e.preventDefault(); App.logout(); }\n    else if (a === 'password') { e.preventDefault(); $('#userMenu').hidden = true; App.changePassword(); }\n    else if (a === 'more') { e.preventDefault(); App.moreMenu(); }\n    else if (a === 'panduan' || a === 'pengaturan') { e.preventDefault(); App.go(a); }\n    return;\n  }\n  if (e.target.closest('#userBtn')) { App.toggleUserMenu(); return; }\n  if (e.target.closest('#brandLink')) { e.preventDefault(); App.go(App.defaultPage()); return; }\n  if (!e.target.closest('#userMenu')) $('#userMenu').hidden = true;\n});\n\nwindow.addEventListener('afterprint', () => { $('#printArea').innerHTML = ''; });\n\nApp.start();\n</script>\n",
  "Styles": "<style>\n/* ==========================================================================\n   KasirWarung AI — Styles\n   Warm \"warung\" look: orange awnings, yellow price tags, fresh green.\n   Mobile-first · 18px base · 44px+ touch targets · 16px radius\n   © 2026 KasirWarung AI · Made by Piyu\n   ========================================================================== */\n:root{\n  --primary:#F97316; --primary-600:#EA580C; --primary-700:#C2410C; --primary-50:#FFF7ED; --primary-100:#FFEDD5; --primary-200:#FED7AA;\n  --secondary:#FACC15; --secondary-100:#FEF9C3; --secondary-ink:#713F12;\n  --accent:#16A34A; --accent-700:#15803D; --accent-50:#F0FDF4; --accent-100:#DCFCE7;\n  --danger:#DC2626; --danger-50:#FEF2F2; --warn:#B45309; --warn-50:#FFFBEB;\n  --ink:#1F2937; --ink-2:#374151; --muted:#6B7280; --line:#F1E6DA;\n  --bg:#FFF8F0; --card:#FFFFFF;\n  --radius:16px; --radius-sm:12px;\n  --shadow:0 6px 20px rgba(124,45,18,.08), 0 1px 3px rgba(124,45,18,.06);\n  --shadow-lg:0 18px 40px rgba(124,45,18,.18);\n  --header-h:64px; --sidebar-w:252px; --bottom-h:72px;\n  --s1:#1baf7a; --s2:#eb6834; --s3:#2a78d6; --s4:#4a3aa7;\n  --font:'Nunito',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;\n}\n*{box-sizing:border-box}\nhtml{font-size:18px;-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);line-height:1.45;min-height:100vh;-webkit-font-smoothing:antialiased}\nimg{max-width:100%}\na{color:var(--primary-700)}\nh1,h2,h3{line-height:1.2;margin:0 0 .5rem}\nh1{font-size:1.5rem;font-weight:900}\nh2{font-size:1.2rem;font-weight:900}\nh3{font-size:1.02rem;font-weight:800}\np{margin:.25rem 0 .75rem}\nsmall,.small{font-size:.8rem}\n.muted{color:var(--muted)}\n.num{font-variant-numeric:tabular-nums}\n.nowrap{white-space:nowrap}\n.hidden,[hidden]{display:none !important}\n.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}\n:focus-visible{outline:3px solid var(--secondary);outline-offset:2px}\n\n/* ---------- Header with awning ---------- */\n.topbar{position:sticky;top:0;z-index:40;height:var(--header-h);display:flex;align-items:center;gap:.6rem;padding:0 12px;\n  background:linear-gradient(180deg,var(--primary) 0%,var(--primary-600) 100%);color:#fff;box-shadow:0 2px 0 rgba(0,0,0,.05)}\n.topbar::after{content:\"\";position:absolute;left:0;right:0;top:100%;height:12px;pointer-events:none;\n  background:radial-gradient(circle at 12px 0,var(--primary-600) 11px,transparent 12px) repeat-x;background-size:24px 12px;\n  filter:drop-shadow(0 3px 2px rgba(124,45,18,.18))}\n.awning-stripes{position:absolute;left:0;right:0;top:0;height:6px;background:repeating-linear-gradient(90deg,#fff 0 22px,transparent 22px 44px);opacity:.28}\n.brand{display:flex;align-items:center;gap:.55rem;min-width:0;flex:1;color:#fff;text-decoration:none}\n.brand-logo{width:40px;height:40px;border-radius:12px;background:#fff;display:grid;place-items:center;overflow:hidden;flex:0 0 auto;box-shadow:0 2px 0 rgba(0,0,0,.12)}\n.brand-logo img{width:100%;height:100%;object-fit:cover}\n.brand-text{min-width:0;display:flex;flex-direction:column}\n.brand-name{font-weight:900;font-size:1.05rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-shadow:0 1px 0 rgba(0,0,0,.15)}\n.brand-app{font-size:.72rem;font-weight:800;opacity:.95;display:flex;gap:.4rem;align-items:center;white-space:nowrap;overflow:hidden}\n.badge-maker{background:var(--secondary);color:var(--secondary-ink);font-weight:900;font-size:.68rem;padding:2px 8px;border-radius:999px;white-space:nowrap;box-shadow:0 2px 0 rgba(0,0,0,.12)}\n.user-btn{display:flex;align-items:center;gap:.4rem;background:rgba(255,255,255,.18);border:2px solid rgba(255,255,255,.35);color:#fff;\n  border-radius:999px;padding:4px 10px 4px 4px;min-height:44px;font:inherit;font-weight:800;font-size:.85rem;cursor:pointer}\n.user-avatar{width:32px;height:32px;border-radius:50%;background:#fff;color:var(--primary-700);display:grid;place-items:center;font-weight:900}\n.user-name{max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.user-menu{position:absolute;right:10px;top:calc(var(--header-h) + 8px);background:#fff;color:var(--ink);border-radius:var(--radius);box-shadow:var(--shadow-lg);\n  min-width:230px;padding:8px;z-index:60;animation:pop .16s ease-out}\n.user-menu .um-head{padding:8px 10px 10px;border-bottom:1px solid var(--line);margin-bottom:6px}\n.user-menu button{display:flex;gap:.6rem;align-items:center;width:100%;text-align:left;background:none;border:0;padding:10px;border-radius:10px;font:inherit;font-weight:700;min-height:44px;cursor:pointer;color:var(--ink)}\n.user-menu button:hover{background:var(--primary-50)}\n\n/* ---------- Layout ---------- */\n.sidebar{display:none}\nmain#main{padding:24px 14px calc(var(--bottom-h) + 24px);max-width:1280px;margin:0 auto;min-width:0}\n.footer{padding:18px 14px calc(var(--bottom-h) + 18px);text-align:center;color:var(--muted);font-size:.78rem;border-top:1px dashed var(--primary-200);background:#fffdf9}\n.footer a{color:var(--primary-700);font-weight:800;text-decoration:none}\n.footer .f-row{display:flex;flex-wrap:wrap;gap:.35rem .8rem;justify-content:center;align-items:center;margin:.2rem 0}\n.footer .dot{opacity:.5}\nbody.auth .footer{padding-bottom:18px}\nbody.auth main#main{padding-bottom:24px}\n\n.bottomnav{position:fixed;left:0;right:0;bottom:0;z-index:45;height:calc(var(--bottom-h) + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);\n  background:#fff;display:flex;border-top:1px solid var(--line);box-shadow:0 -6px 18px rgba(124,45,18,.08)}\n.bottomnav button{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;background:none;border:0;font:inherit;\n  font-size:.7rem;font-weight:800;color:var(--muted);min-height:44px;cursor:pointer;position:relative}\n.bottomnav button svg{width:26px;height:26px}\n.bottomnav button.active{color:var(--primary-700)}\n.bottomnav button.active::before{content:\"\";position:absolute;top:0;left:25%;right:25%;height:4px;border-radius:0 0 6px 6px;background:var(--primary)}\n.bottomnav .bn-badge{position:absolute;top:6px;right:calc(50% - 22px);background:var(--danger);color:#fff;border-radius:999px;font-size:.62rem;padding:0 5px;min-width:18px}\n\n@media (min-width:768px){\n  .sidebar{display:flex;flex-direction:column;position:fixed;top:calc(var(--header-h) + 12px);bottom:0;left:0;width:var(--sidebar-w);padding:16px 12px;overflow:auto;z-index:30}\n  main#main,.footer{margin-left:var(--sidebar-w)}\n  main#main{padding:28px 28px 40px}\n  .footer{padding-bottom:22px}\n  .bottomnav{display:none}\n  body.auth .sidebar{display:none}\n  body.auth main#main,body.auth .footer{margin-left:0}\n}\n.nav-item{display:flex;align-items:center;gap:.7rem;padding:12px 14px;border-radius:14px;color:var(--ink-2);font-weight:800;text-decoration:none;border:0;background:none;\n  font:inherit;font-size:.95rem;width:100%;text-align:left;cursor:pointer;min-height:48px;transition:background .15s,transform .15s}\n.nav-item svg{width:22px;height:22px;flex:0 0 auto;color:var(--primary-600)}\n.nav-item:hover{background:var(--primary-50);transform:translateX(2px)}\n.nav-item.active{background:var(--primary);color:#fff;box-shadow:0 4px 0 var(--primary-700)}\n.nav-item.active svg{color:#fff}\n.nav-sep{height:1px;background:var(--line);margin:10px 6px}\n.nav-cta{margin-top:auto;background:var(--secondary-100);border-radius:var(--radius);padding:12px;font-size:.8rem;color:var(--secondary-ink)}\n\n/* ---------- Pages ---------- */\n.page{animation:fadeUp .28s ease-out}\n.page-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:.75rem;margin-bottom:1rem}\n.page-head h1{margin:0}\n.page-head .sub{color:var(--muted);font-size:.9rem;margin:.15rem 0 0}\n.actions{display:flex;flex-wrap:wrap;gap:.5rem}\n.grid{display:grid;gap:14px}\n.g2{grid-template-columns:minmax(0,1fr)}\n.g3{grid-template-columns:minmax(0,1fr)}\n.g4{grid-template-columns:repeat(2,minmax(0,1fr))}\n@media (min-width:768px){.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}.g4{grid-template-columns:repeat(4,minmax(0,1fr))}}\n.stack>*+*{margin-top:14px}\n\n/* ---------- Cards ---------- */\n.card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px;border:1px solid #fff}\n.card-head{display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin-bottom:.6rem}\n.card-head h2,.card-head h3{margin:0}\n.card.tint-orange{background:linear-gradient(135deg,#fff 0%,var(--primary-50) 100%)}\n.card.tint-yellow{background:linear-gradient(135deg,#fff 0%,var(--secondary-100) 100%)}\n.card.tint-green{background:linear-gradient(135deg,#fff 0%,var(--accent-50) 100%)}\n\n.kpi{position:relative;overflow:hidden}\n.kpi .k-label{font-size:.78rem;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.02em;display:flex;gap:.35rem;align-items:center}\n.kpi .k-value{font-size:1.35rem;font-weight:900;margin-top:4px;word-break:break-word}\n.kpi .k-sub{font-size:.78rem;color:var(--muted);margin-top:2px}\n.kpi .k-icon{position:absolute;right:10px;top:10px;width:36px;height:36px;border-radius:12px;display:grid;place-items:center}\n.kpi .k-icon svg{width:20px;height:20px}\n.ic-orange{background:var(--primary-100);color:var(--primary-700)}\n.ic-yellow{background:var(--secondary-100);color:var(--secondary-ink)}\n.ic-green{background:var(--accent-100);color:var(--accent-700)}\n.ic-red{background:var(--danger-50);color:var(--danger)}\n@media (min-width:768px){.kpi .k-value{font-size:1.55rem}}\n\n/* ---------- Buttons ---------- */\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:48px;padding:10px 18px;border-radius:14px;border:0;cursor:pointer;\n  font:inherit;font-weight:900;font-size:.95rem;line-height:1.1;text-decoration:none;color:var(--ink);background:#fff;\n  box-shadow:0 4px 0 var(--line),0 1px 0 rgba(0,0,0,.02) inset;border:2px solid var(--line);transition:transform .08s,box-shadow .08s,filter .15s;user-select:none}\n.btn svg{width:20px;height:20px;flex:0 0 auto}\n.btn:hover{filter:brightness(1.03)}\n.btn:active{transform:translateY(3px);box-shadow:0 1px 0 var(--line)}\n.btn[disabled]{opacity:.55;pointer-events:none}\n.btn-primary{background:var(--primary);color:#fff;border-color:var(--primary);box-shadow:0 4px 0 var(--primary-700)}\n.btn-primary:active{box-shadow:0 1px 0 var(--primary-700)}\n.btn-yellow{background:var(--secondary);color:var(--secondary-ink);border-color:var(--secondary);box-shadow:0 4px 0 #CA8A04}\n.btn-yellow:active{box-shadow:0 1px 0 #CA8A04}\n.btn-green{background:var(--accent);color:#fff;border-color:var(--accent);box-shadow:0 4px 0 var(--accent-700)}\n.btn-green:active{box-shadow:0 1px 0 var(--accent-700)}\n.btn-danger{background:#fff;color:var(--danger);border-color:#FECACA;box-shadow:0 4px 0 #FECACA}\n.btn-wa{background:#25D366;color:#073B1C;border-color:#25D366;box-shadow:0 4px 0 #128C7E}\n.btn-ghost{background:transparent;border-color:transparent;box-shadow:none;color:var(--primary-700)}\n.btn-ghost:active{box-shadow:none}\n.btn-sm{min-height:44px;padding:6px 12px;font-size:.85rem;border-radius:12px}\n.btn-lg{min-height:58px;font-size:1.1rem;padding:12px 22px}\n.btn-block{width:100%}\n.icon-btn{width:44px;height:44px;min-height:44px;padding:0;border-radius:12px}\n.chip{display:inline-flex;align-items:center;gap:.3rem;min-height:40px;padding:6px 14px;border-radius:999px;background:#fff;border:2px solid var(--line);font:inherit;font-weight:800;font-size:.85rem;cursor:pointer;white-space:nowrap;color:var(--ink-2)}\n.chip.active{background:var(--primary);border-color:var(--primary);color:#fff}\n.chips{display:flex;gap:.45rem;overflow-x:auto;padding:2px 2px 8px;scrollbar-width:none}\n.chips::-webkit-scrollbar{display:none}\n\n/* ---------- Badges & tags ---------- */\n.badge{display:inline-flex;align-items:center;gap:.25rem;font-size:.72rem;font-weight:900;padding:3px 9px;border-radius:999px;white-space:nowrap;line-height:1.3}\n.b-green{background:var(--accent-100);color:var(--accent-700)}\n.b-yellow{background:var(--secondary-100);color:var(--secondary-ink)}\n.b-red{background:var(--danger-50);color:var(--danger)}\n.b-orange{background:var(--primary-100);color:var(--primary-700)}\n.b-gray{background:#F3F4F6;color:var(--ink-2)}\n.b-ai{background:linear-gradient(90deg,#7C3AED,#DB2777);color:#fff}\n.b-noai{background:#F3F4F6;color:var(--ink-2);border:1px dashed #9CA3AF}\n.badge svg{width:14px;height:14px}\n.price-tag{position:relative;display:inline-block;background:var(--secondary);color:var(--secondary-ink);font-weight:900;padding:4px 10px 4px 16px;border-radius:6px 10px 10px 6px;\n  clip-path:polygon(10px 0,100% 0,100% 100%,10px 100%,0 50%);white-space:nowrap;font-variant-numeric:tabular-nums}\n.price-tag::before{content:\"\";position:absolute;left:8px;top:50%;width:5px;height:5px;margin-top:-2.5px;border-radius:50%;background:#fff}\n.price-tag.sm{font-size:.78rem;padding:2px 8px 2px 14px}\n.price-tag.green{background:var(--accent-100);color:var(--accent-700)}\n\n/* ---------- Forms ---------- */\n.field{display:block;margin-bottom:12px}\n.field>span,.field-label{display:block;font-weight:800;font-size:.85rem;margin-bottom:5px;color:var(--ink-2)}\n.field .hint{font-size:.75rem;color:var(--muted);margin-top:4px;display:block;font-weight:600}\ninput,select,textarea{font:inherit;font-size:1rem;color:var(--ink);width:100%;min-width:0;min-height:48px;padding:10px 14px;border-radius:12px;border:2px solid #EADBCB;background:#fff;transition:border-color .15s,box-shadow .15s}\ntextarea{min-height:110px;resize:vertical}\ninput:focus,select:focus,textarea:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 4px rgba(249,115,22,.15)}\ninput[type=checkbox]{width:24px;height:24px;min-height:24px;accent-color:var(--accent)}\n.row{display:flex;gap:10px;flex-wrap:wrap}\n.row>*{flex:1 1 140px}\n.switch{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;font-weight:800}\n.switch input{appearance:none;width:56px;height:32px;min-height:32px;border-radius:999px;background:#E5E7EB;position:relative;cursor:pointer;border:0;padding:0;flex:0 0 auto}\n.switch input::after{content:\"\";position:absolute;top:4px;left:4px;width:24px;height:24px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:left .18s}\n.switch input:checked{background:var(--accent)}\n.switch input:checked::after{left:28px}\n.search{position:relative}\n.search svg{position:absolute;left:14px;top:50%;margin-top:-11px;width:22px;height:22px;color:var(--muted);pointer-events:none}\n.search input{padding-left:46px;font-size:1.05rem;min-height:54px;border-radius:16px}\n.pw-wrap{position:relative}\n.pw-wrap input{padding-right:78px}\n.pw-wrap button{position:absolute;right:6px;top:6px;bottom:6px;border:0;background:var(--primary-50);color:var(--primary-700);font:inherit;font-weight:800;font-size:.8rem;border-radius:10px;padding:0 10px;cursor:pointer}\n\n/* ---------- Tables → cards on phones ---------- */\n.table-wrap{overflow-x:auto}\ntable.rtable{width:100%;border-collapse:separate;border-spacing:0;font-size:.9rem}\n.rtable th{text-align:left;font-size:.75rem;text-transform:uppercase;letter-spacing:.03em;color:var(--muted);padding:10px;border-bottom:2px solid var(--line);white-space:nowrap}\n.rtable td{padding:10px;border-bottom:1px solid var(--line);vertical-align:middle}\n.rtable tr:last-child td{border-bottom:0}\n.rtable tbody tr:hover td{background:#FFFBF5}\n.rtable .n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}\n@media (max-width:767px){\n  .rtable thead{display:none}\n  .rtable,.rtable tbody,.rtable tr,.rtable td{display:block;width:100%}\n  .rtable tr{background:#fff;border:1px solid var(--line);border-radius:14px;padding:8px 12px;margin-bottom:10px;box-shadow:0 2px 6px rgba(124,45,18,.05)}\n  .rtable td{display:flex;justify-content:space-between;align-items:center;gap:10px;border:0;padding:6px 0;text-align:right}\n  .rtable td::before{content:attr(data-label);font-weight:800;color:var(--muted);font-size:.78rem;text-align:left;flex:0 0 auto}\n  .rtable td.td-title{font-weight:900;font-size:1rem;text-align:left;justify-content:flex-start}\n  .rtable td.td-title::before{display:none}\n  .rtable td.td-actions{justify-content:flex-end;flex-wrap:wrap}\n  .rtable td.td-actions::before{display:none}\n  .rtable .n{white-space:normal}\n}\n\n/* ---------- Lists ---------- */\n.list{list-style:none;margin:0;padding:0}\n.list li{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px dashed var(--line)}\n.list li:last-child{border-bottom:0}\n.list .li-main{flex:1;min-width:0}\n.list .li-title{font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.list .li-sub{font-size:.78rem;color:var(--muted)}\n\n/* ---------- Notices ---------- */\n.notice{border-radius:14px;padding:12px 14px;font-size:.9rem;display:flex;gap:.6rem;align-items:flex-start;margin-bottom:12px}\n.notice svg{width:22px;height:22px;flex:0 0 auto;margin-top:1px}\n.n-warn{background:var(--warn-50);color:#78350F;border:1px solid #FDE68A}\n.n-info{background:var(--primary-50);color:var(--primary-700);border:1px solid var(--primary-200)}\n.n-ok{background:var(--accent-50);color:var(--accent-700);border:1px solid #BBF7D0}\n.n-err{background:var(--danger-50);color:#991B1B;border:1px solid #FECACA}\n.license-banner{background:var(--secondary);color:var(--secondary-ink);font-weight:800;font-size:.85rem;padding:8px 14px;text-align:center}\n.license-banner a{color:inherit}\n\n/* ---------- Empty states ---------- */\n.empty{text-align:center;padding:22px 12px;color:var(--muted)}\n.empty svg{width:150px;height:auto;margin:0 auto 8px;display:block}\n.empty h3{color:var(--ink-2);margin-bottom:.2rem}\n.empty p{margin:0 auto;max-width:340px;font-size:.88rem}\n\n/* ---------- Modal / sheet ---------- */\n.modal-wrap{position:fixed;inset:0;z-index:80;background:rgba(31,41,55,.5);display:flex;align-items:flex-end;justify-content:center;animation:fade .15s}\n.modal{background:#fff;width:100%;max-width:640px;max-height:92vh;border-radius:22px 22px 0 0;display:flex;flex-direction:column;animation:sheetUp .22s ease-out;box-shadow:var(--shadow-lg)}\n.modal.wide{max-width:900px}\n.modal-head{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:14px 16px 10px;border-bottom:1px solid var(--line)}\n.modal-head h2{margin:0;font-size:1.1rem}\n.modal-body{padding:16px;overflow:auto;flex:1}\n.modal-foot{padding:12px 16px calc(12px + env(safe-area-inset-bottom));border-top:1px solid var(--line);display:flex;gap:10px;flex-wrap:wrap}\n.modal-foot .btn{flex:1 1 140px}\n.modal-grip{width:44px;height:5px;border-radius:5px;background:#E5E7EB;margin:8px auto 0}\n@media (min-width:768px){.modal-wrap{align-items:center}.modal{border-radius:22px}.modal-grip{display:none}}\n\n/* ---------- Toast & busy ---------- */\n#toast{position:fixed;left:50%;bottom:calc(var(--bottom-h) + 16px);transform:translateX(-50%);z-index:100;display:flex;flex-direction:column;gap:8px;width:min(92vw,440px);pointer-events:none}\n@media (min-width:768px){#toast{bottom:24px}}\n.toast{background:var(--ink);color:#fff;padding:10px 14px;border-radius:14px;font-weight:800;font-size:.85rem;box-shadow:var(--shadow-lg);animation:toastIn .22s ease-out;display:flex;gap:.5rem;align-items:center;pointer-events:auto}\n.toast.ok{background:var(--accent-700)}\n.toast.err{background:#B91C1C}\n.toast svg{width:20px;height:20px;flex:0 0 auto}\n#busy{position:fixed;inset:0;z-index:120;background:rgba(255,248,240,.72);display:grid;place-items:center;backdrop-filter:blur(2px)}\n.busy-box{background:#fff;border-radius:18px;padding:18px 22px;box-shadow:var(--shadow-lg);display:flex;align-items:center;gap:12px;font-weight:800}\n.spinner{width:26px;height:26px;border-radius:50%;border:4px solid var(--primary-100);border-top-color:var(--primary);animation:spin .8s linear infinite;flex:0 0 auto}\n.spinner.sm{width:18px;height:18px;border-width:3px}\n.skeleton{background:linear-gradient(90deg,#F5EDE4 25%,#FBF6F0 50%,#F5EDE4 75%);background-size:200% 100%;animation:shimmer 1.2s infinite;border-radius:10px;min-height:18px}\n\n/* ---------- Boot splash ---------- */\n#bootSplash{position:fixed;inset:0;z-index:150;background:var(--bg);display:grid;place-items:center;text-align:center}\n#bootSplash .bs-logo{width:92px;height:92px;margin:0 auto 12px;animation:bob 1.2s ease-in-out infinite}\n#bootSplash .bs-name{font-weight:900;font-size:1.3rem;color:var(--primary-700)}\n\n/* ---------- Auth ---------- */\n.auth-wrap{min-height:calc(100vh - 220px);display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;align-items:center;padding:8px 0}\n.auth-card{width:100%;max-width:440px;padding:22px}\n.auth-illus svg{width:100%;max-width:260px;display:block;margin:0 auto 6px}\n.auth-title{text-align:center;margin-bottom:.1rem}\n.auth-sub{text-align:center;color:var(--muted);margin-bottom:1rem}\n\n/* ---------- Setup wizard ---------- */\n.steps{display:flex;gap:6px;margin-bottom:16px}\n.steps span{flex:1;height:8px;border-radius:8px;background:var(--primary-100)}\n.steps span.on{background:var(--primary)}\n.choice{display:flex;gap:12px;align-items:flex-start;padding:14px;border:2px solid var(--line);border-radius:14px;cursor:pointer;margin-bottom:10px;background:#fff}\n.choice input{margin-top:3px;width:22px;height:22px;min-height:22px;flex:0 0 auto;accent-color:var(--primary)}\n.choice.on{border-color:var(--primary);background:var(--primary-50)}\n.choice b{display:block}\n\n/* ---------- POS ---------- */\n.pos{display:grid;gap:14px;grid-template-columns:minmax(0,1fr)}\n@media (min-width:1024px){.pos{grid-template-columns:minmax(0,1fr) 400px;align-items:start}.pos-cart{position:sticky;top:calc(var(--header-h) + 24px)}}\n.pos-toolbar{display:flex;gap:8px;align-items:center;margin-bottom:10px}\n.pos-toolbar .search{flex:1}\n.prod-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}\n.prod{position:relative;background:#fff;border-radius:16px;border:2px solid #fff;box-shadow:var(--shadow);padding:12px;text-align:left;cursor:pointer;font:inherit;color:var(--ink);\n  min-height:118px;display:flex;flex-direction:column;gap:6px;transition:transform .1s,border-color .15s}\n.prod:hover{border-color:var(--primary-200)}\n.prod:active{transform:scale(.97)}\n.prod .p-name{font-weight:800;font-size:.9rem;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.prod .p-meta{font-size:.72rem;color:var(--muted);margin-top:auto;display:flex;justify-content:space-between;gap:4px;align-items:center}\n.prod .p-cat{position:absolute;top:8px;right:8px;width:10px;height:10px;border-radius:50%}\n.prod.out{opacity:.5}\n.prod.flash{animation:flash .45s}\n.prod .p-incart{position:absolute;top:-6px;left:-6px;background:var(--accent);color:#fff;border-radius:999px;font-size:.72rem;font-weight:900;min-width:24px;height:24px;display:grid;place-items:center;padding:0 6px;box-shadow:0 2px 0 var(--accent-700)}\n.cart-list{list-style:none;margin:0;padding:0;max-height:52vh;overflow:auto}\n.cart-item{display:grid;grid-template-columns:1fr auto;gap:6px 10px;padding:10px 0;border-bottom:1px dashed var(--line);animation:fadeUp .2s}\n.cart-item .ci-name{font-weight:800;font-size:.92rem;line-height:1.25}\n.cart-item .ci-price{font-size:.78rem;color:var(--muted);display:flex;gap:.35rem;align-items:center;flex-wrap:wrap}\n.cart-item .ci-total{font-weight:900;text-align:right;font-variant-numeric:tabular-nums}\n.stepper{display:inline-flex;align-items:center;border:2px solid var(--line);border-radius:14px;overflow:hidden;background:#fff}\n.stepper button{width:44px;height:44px;border:0;background:var(--primary-50);color:var(--primary-700);font-size:1.3rem;font-weight:900;cursor:pointer}\n.stepper button:active{background:var(--primary-100)}\n.stepper input{width:64px;min-height:44px;height:44px;border:0;border-radius:0;text-align:center;font-weight:900;padding:0 4px}\n.pos-cart .card-head{flex-wrap:nowrap}\n.pos-cart .card-head h2{white-space:nowrap;display:flex;gap:.4rem;align-items:center}\n.pos-cart .card-head .actions{flex-wrap:nowrap}\n.cart-item .stepper{justify-self:start}\n.cart-item>div:last-child{align-self:center}\n.pay-sticky{position:sticky;top:-16px;background:#fff;z-index:2;padding:4px 0 8px;margin-top:-4px}\n.cart-total{display:flex;justify-content:space-between;align-items:baseline;font-weight:900;font-size:1.35rem;padding:10px 0}\n.cart-bar{position:fixed;left:10px;right:10px;bottom:calc(var(--bottom-h) + 10px);z-index:44;display:none}\n.cart-bar .btn{width:100%;justify-content:space-between;min-height:60px;font-size:1.02rem;border-radius:18px}\n.cart-bar .cb-count{background:#fff;color:var(--primary-700);border-radius:999px;padding:2px 10px;font-size:.85rem}\n@media (max-width:1023px){.pos-cart{display:none}.pos-cart.open{display:block;position:fixed;inset:0;z-index:70;border-radius:0;overflow:auto;padding-bottom:120px;animation:sheetUp .2s}\n  .cart-bar.show{display:block}.pos-cart .close-cart{display:inline-flex !important}}\n.close-cart{display:none !important}\n.pay-methods{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:12px}\n@media (min-width:480px){.pay-methods{grid-template-columns:repeat(4,1fr)}}\n.pay-methods button{min-height:56px;border-radius:14px;border:2px solid var(--line);background:#fff;font:inherit;font-weight:900;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}\n.pay-methods button svg{width:22px;height:22px}\n.pay-methods button.on{border-color:var(--primary);background:var(--primary-50);color:var(--primary-700)}\n.quick-cash{display:flex;flex-wrap:wrap;gap:6px;margin:-4px 0 12px}\n.quick-cash .chip{min-height:44px}\n.big-total{font-size:2rem;font-weight:900;color:var(--primary-700);text-align:center;font-variant-numeric:tabular-nums}\n.success-burst{text-align:center;padding:10px 0}\n.success-burst .check{width:84px;height:84px;margin:0 auto 8px;border-radius:50%;background:var(--accent);display:grid;place-items:center;color:#fff;animation:pop .35s ease-out;box-shadow:0 6px 0 var(--accent-700)}\n.success-burst .check svg{width:48px;height:48px}\n.change-amount{font-size:2.2rem;font-weight:900;color:var(--accent-700)}\n\n/* ---------- Kasbon ---------- */\n.cust-card{display:flex;flex-direction:column;gap:8px}\n.cust-top{display:flex;gap:10px;align-items:center}\n.avatar{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;font-weight:900;color:#fff;flex:0 0 auto;font-size:1.05rem}\n.limit-bar{height:10px;border-radius:10px;background:#F3F4F6;overflow:hidden}\n.limit-bar i{display:block;height:100%;border-radius:10px;background:var(--accent);transition:width .4s}\n.limit-bar i.warn{background:#F59E0B}\n.limit-bar i.over{background:var(--danger)}\n.ai-box{border:2px dashed #C4B5FD;background:#FAF5FF;border-radius:14px;padding:12px;white-space:pre-wrap}\n\n/* ---------- Charts ---------- */\n.chart-box{position:relative;height:260px}\n.chart-box.sm{height:230px}\n.legend{display:flex;flex-wrap:wrap;gap:.4rem .9rem;font-size:.8rem;font-weight:700;color:var(--ink-2);margin-top:8px}\n.legend i{display:inline-block;width:12px;height:12px;border-radius:4px;margin-right:5px;vertical-align:-1px}\n\n/* ---------- Misc ---------- */\n.tabs{display:flex;gap:6px;background:#fff;padding:6px;border-radius:16px;box-shadow:var(--shadow);margin-bottom:14px;overflow-x:auto}\n.tabs button{flex:1;min-height:44px;border:0;background:none;border-radius:12px;font:inherit;font-weight:900;font-size:.88rem;color:var(--muted);cursor:pointer;white-space:nowrap;padding:0 12px}\n.tabs button.on{background:var(--primary);color:#fff}\ndetails.faq{background:#fff;border-radius:14px;box-shadow:var(--shadow);margin-bottom:10px;overflow:hidden}\ndetails.faq summary{cursor:pointer;padding:14px 16px;font-weight:800;list-style:none;display:flex;justify-content:space-between;gap:10px;min-height:48px;align-items:center}\ndetails.faq summary::-webkit-details-marker{display:none}\ndetails.faq summary::after{content:\"+\";font-size:1.4rem;color:var(--primary);font-weight:900}\ndetails.faq[open] summary::after{content:\"–\"}\ndetails.faq .faq-body{padding:0 16px 14px;color:var(--ink-2);font-size:.92rem}\n.hero{background:linear-gradient(135deg,var(--primary) 0%,var(--primary-600) 60%,#DB2777 130%);color:#fff;border-radius:22px;padding:26px 20px;position:relative;overflow:hidden}\n.hero h1{font-size:1.7rem}\n.hero .btn{margin-top:6px}\n.feature{display:flex;gap:12px;align-items:flex-start}\n.feature .f-ic{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;flex:0 0 auto}\n.feature .f-ic svg{width:26px;height:26px}\n.legal h2{margin-top:1.2rem}\n.legal li{margin-bottom:.35rem}\n.kbd{font-family:ui-monospace,Menlo,monospace;background:#F3F4F6;border-radius:6px;padding:1px 6px;font-size:.85em}\n.divider{height:1px;background:var(--line);margin:14px 0}\n.text-right{text-align:right}\n.mt0{margin-top:0}.mb0{margin-bottom:0}.mt1{margin-top:.5rem}.mt2{margin-top:1rem}\n.w100{width:100%}\n\n/* ---------- Phone refinements (5-inch Android) ---------- */\n@media (max-width:767px){\n  .topbar{gap:.4rem;padding:0 10px}\n  .user-name{display:none}\n  .user-btn{padding:4px}\n  .brand-name{font-size:.98rem}\n  .brand-app{font-size:.66rem;gap:.3rem}\n  .badge-maker{font-size:.62rem;padding:1px 7px}\n  h1{font-size:1.3rem}\n  .page-head{margin-bottom:.75rem}\n  .page-head .sub{font-size:.82rem}\n  .page-head .actions .btn{min-height:44px;padding:6px 12px;font-size:.85rem;border-radius:12px}\n  .page-head .actions .btn svg{width:18px;height:18px}\n  .card{padding:14px}\n  .kpi .k-value{font-size:clamp(1rem,5vw,1.3rem);white-space:nowrap}\n  .kpi .k-label{padding-right:38px;font-size:.68rem}\n  .kpi .k-icon{width:30px;height:30px;right:8px;top:8px}\n  .kpi .k-icon svg{width:17px;height:17px}\n  .hide-phone{display:none !important}\n}\n\n/* ---------- Animations ---------- */\n@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}\n@keyframes fade{from{opacity:0}to{opacity:1}}\n@keyframes sheetUp{from{transform:translateY(40px);opacity:.3}to{transform:none;opacity:1}}\n@keyframes pop{0%{transform:scale(.6);opacity:0}70%{transform:scale(1.08)}100%{transform:scale(1);opacity:1}}\n@keyframes toastIn{from{transform:translateY(12px);opacity:0}to{transform:none;opacity:1}}\n@keyframes spin{to{transform:rotate(360deg)}}\n@keyframes shimmer{to{background-position:-200% 0}}\n@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}\n@keyframes flash{0%{border-color:var(--accent);box-shadow:0 0 0 6px rgba(22,163,74,.2)}100%{border-color:#fff}}\n@keyframes bump{0%{transform:scale(1)}40%{transform:scale(1.25)}100%{transform:scale(1)}}\n.bump{animation:bump .3s}\n@media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important}}\n\n/* ---------- 58mm thermal receipt ---------- */\n#printArea{display:none}\n.receipt{width:48mm;font-family:'Courier New',ui-monospace,monospace;font-size:11px;line-height:1.35;color:#000}\n.receipt .r-c{text-align:center}\n.receipt .r-b{font-weight:bold}\n.receipt .r-big{font-size:14px;font-weight:bold}\n.receipt .r-line{border-top:1px dashed #000;margin:4px 0}\n.receipt .r-row{display:flex;justify-content:space-between;gap:4px}\n.receipt .r-item{margin:2px 0}\n.receipt .r-muted{font-size:10px}\n.receipt-preview{background:#fff;border:1px dashed #D1D5DB;border-radius:10px;padding:10px;margin:0 auto;width:fit-content;box-shadow:inset 0 0 0 4px #FAFAFA}\n@media print{\n  @page{size:58mm auto;margin:0}\n  html,body{background:#fff !important;font-size:11px}\n  body *{visibility:hidden}\n  #printArea,#printArea *{visibility:visible}\n  #printArea{display:block !important;position:absolute;left:0;top:0;width:58mm;padding:2mm 5mm 6mm}\n  #app,#toast,#busy,.modal-wrap{display:none !important}\n}\n/* ---------- Public shop (?page=toko) ---------- */\n.shop-head{display:flex;align-items:center;gap:12px}\n.shop-head h1{font-size:1.35rem;line-height:1.2}\n.shop-logo{width:56px;height:56px;border-radius:16px;object-fit:cover;flex:0 0 auto;display:grid;place-items:center;background:var(--primary-50);color:var(--primary-700)}\n.shop-logo svg{width:30px;height:30px}\n.shop-prod{cursor:default;display:flex;flex-direction:column;gap:6px}\n.shop-prod .stepper input{width:46px;text-align:center;border:0;min-height:40px;padding:0;font-weight:900}\n.shop-prod .stepper button{width:40px;height:40px}\n.shop-prod.out{opacity:.6}\n.shop-bar{position:fixed;left:10px;right:10px;bottom:12px;z-index:44;max-width:560px;margin:0 auto}\n.shop-bar .btn{width:100%;justify-content:space-between;min-height:58px;font-size:1.02rem;border-radius:18px}\n.shop-bar .cb-count{background:#fff;color:var(--primary-700);border-radius:999px;padding:2px 10px;font-size:.85rem}\n#page-toko{padding-bottom:84px}\n.hp-field{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}\n.code-block{background:#1F2937;color:#F9FAFB;border-radius:12px;padding:12px;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;word-break:break-all;margin:.5rem 0}\n</style>\n"
